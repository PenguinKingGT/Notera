{
  "name": "notera",
  "version": "0.1.0",
  "description": "Notera desktop music notation editor",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Notera contributors",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "benchmark:notation": "node scripts/notation-benchmark/run.mjs",
    "package": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "postinstall": "install-electron",
    "verify:musicxml": "node scripts/musicxml-exchange/verify-schema.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.577.0",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.0.0",
    "tone": "15.1.22",
    "verovio": "6.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vexflow": "5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "productName": "Notera"
}
